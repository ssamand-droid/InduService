# Development only. Copy this file to .env in backend/.
SECRET_KEY=local-development-only-change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# SQLite keeps the first local dev setup self-contained.
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3
DB_USER=
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=
