# Local production-like test only. Copy to .env.local-prod in backend/.
# In WSL, load with: set -a; source .env.local-prod; set +a
SECRET_KEY=replace-with-a-local-only-long-random-secret
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1

DB_ENGINE=django.db.backends.postgresql
DB_NAME=induservice_local_prod
DB_USER=induservice_local_prod
DB_PASSWORD=replace-with-a-local-only-password
DB_HOST=127.0.0.1
DB_PORT=5432
